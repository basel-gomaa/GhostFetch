# WHAT THIS IMAGE DEPENDS ON. The image installs requirements.txt, the lock
# made from this file (every package pinned, with hashes):
#     python3 scripts/image_locks.py lock facebook
# Edit here, then re-lock; never edit requirements.txt by hand.
#
# facebook's OWN dependencies, installed only into this Actor's image.
#
# ONE package, and that is not an accident: the collector's page and group
# paths are browser-free by design, driving Facebook's GraphQL endpoint over
# plain HTTP. Playwright is imported lazily inside engine.py and reached only
# by the single-post comment path, which this Actor does not use -- so there is
# no Chromium and no 400 MB image.
#
# h2 comes with the [http2] extra, which the replay engine prefers.
httpx[http2]==0.28.1

# The analysis and report stage. Still no browser -- these are the vendored
# processors/ai/reports layer's own dependencies, scanned from its imports:
#
#   anthropic        ai/claude.py and ai/segmentation.py
#   reportlab        reports/facebook_report.py (the PDF)
#   python-dotenv    config.py, which ai/claude.py imports for the API key
#   arabic-reshaper  \ reports/facebook_report.py shapes Arabic text for the
#   python-bidi      / PDF, and real pages here post in Arabic
#
# reports/dashboard.py writes HTML with the standard library only.
anthropic>=2.4.0
reportlab>=4.0
python-dotenv>=1.0
arabic-reshaper>=3.1.0
python-bidi>=0.4
