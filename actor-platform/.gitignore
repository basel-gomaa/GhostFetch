__pycache__/
*.py[cod]

# Run artifacts: input, output, logs and run records are per-execution.
storage/
.venv/

# GENERATED by actors/facebook/sync_collector.sh, and deliberately not tracked.
# The pipeline repository is the source of truth for the collector and the
# analysis/report layer; a committed copy would be a second place to "fix" them
# and would drift. test_facebook.py compares the two and FAILS on any edit, so
# the copy has to be regenerated rather than curated.
#
#     ./actors/facebook/sync_collector.sh [path-to-pipeline-repo]
actors/*/vendor/

# The console's dependencies and its BUILD OUTPUT. ui/static/ is generated by
# `npm run build` in ui/console/, so it is regenerated rather than committed --
# a stale bundle checked in beside changed sources is a confusing way to ship
# yesterday's UI. The API serves whatever is there and says so plainly when
# there is nothing.
ui/console/node_modules/
ui/static/

# Local secrets: the session-encryption key lives here.
.env.local
.env.local.bak

# Durable per-account Actor state -- browser profiles, which carry a logged-in
# account's cookies and local storage. It lives OUTSIDE the repository by
# default (~/.actor-platform/state/), for the same reason the session scratch
# does: storage/runs/ is the tree the API serves. These patterns are the safety
# net for a deployment that points ACTOR_PLATFORM_STATE_DIR inside the repo.
.actor-platform/
state/
**/browser-profile/
