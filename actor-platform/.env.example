# The platform's settings, read by run-local.sh. Copy to .env.local:
#     cp .env.example .env.local && chmod 600 .env.local
# .env.local is gitignored. KEEP IT: ACTOR_PLATFORM_SECRET_KEY decrypts every
# stored social session, and replacing it means everyone reconnects.

# --- required ---------------------------------------------------------------
# Encrypts stored sessions (AES-256-GCM). Generate once:
#     .venv/bin/python -c "from shared.crypto import generate_key; print(generate_key())"
ACTOR_PLATFORM_SECRET_KEY=REPLACE_ME

# The database password. Used by docker compose when the volume is first
# created, and must match the URL below. Generate once:
#     python3 -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=REPLACE_ME
ACTOR_PLATFORM_DATABASE_URL=postgresql://actorplatform:REPLACE_ME@127.0.0.1:5433/actorplatform

# Operator API key(s), comma-separated, each `key` or `key:scopes` (read, run,
# read+run). An operator key is an ADMIN over every user's runs -- even a
# read-only one can read them all -- and every use is written to the event log
# (as a fingerprint, never the key). For an integration that should see only
# one user's data, sign in as that user and mint a personal key instead
# (console: API keys, or POST /me/api-keys). Rotate by adding the new key,
# switching callers over, then removing the old one and restarting.
ACTOR_PLATFORM_API_KEYS=apk_REPLACE_WITH_A_LONG_RANDOM_VALUE

# Forwarded into Actor containers for the AI analysis step.
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# --- public deployment -------------------------------------------------------
# Set PUBLIC_DOMAIN when starting (PUBLIC_DOMAIN=x.example.com ./run-local.sh)
# rather than here, so a local start never accidentally goes public.
# ACTOR_PLATFORM_REQUIRE_HTTPS=1          # set automatically in public mode
# ACTOR_PLATFORM_ALLOW_INSECURE_HTTP=1    # escape hatch for a trusted LAN only

# --- limits and fair use (defaults shown) -------------------------------------
# ACTOR_PLATFORM_MAX_ACTIVE_RUNS_PER_USER=10   # queued+running per non-admin user; 0 = off
# ACTOR_PLATFORM_MAX_QUEUE_DEPTH=500           # whole queue; 0 = off
# ACTOR_PLATFORM_LOGIN_PER_IP=20               # login attempts per address per 10 min
# ACTOR_PLATFORM_SIGNUPS_PER_IP=5              # sign-ups per address per hour
# ACTOR_PLATFORM_LOCK_AFTER_FAILURES=10        # failed logins before an account locks

# --- who may sign up (defaults shown) -------------------------------------------
# ACTOR_PLATFORM_SIGNUP=invite                 # invite / open / closed; see README
# ACTOR_PLATFORM_INVITE_DAYS=7                 # how long an invite link works (max 30)
# Per-Actor run limits (timeout, memory, CPUs) live in config/actors.json.

# --- saved login-browser profiles (defaults shown) -----------------------------
# ACTOR_PLATFORM_LOGIN_PERSIST_PROFILE=1       # 0 = a throwaway profile per Connect
# ACTOR_PLATFORM_LOGIN_PROFILE_IDLE_DAYS=30    # delete a profile unused this long; 0/off = never

# --- Chrome's sandbox in the browser containers (default shown) ------------------
# ACTOR_PLATFORM_CHROME_SANDBOX=1              # 0 = Chrome runs with --no-sandbox; only
#                                              # for a kernel without unprivileged userns

# --- retention (off unless set) -----------------------------------------------
# ACTOR_PLATFORM_RUN_RETENTION_DAYS=90         # delete finished runs older than this
# ACTOR_PLATFORM_RUN_RETENTION_INCLUDE_OWNERLESS=1

# --- optional: e-mail reports when runs finish ---------------------------------
# ACTOR_PLATFORM_SMTP_HOST=smtp.gmail.com
# ACTOR_PLATFORM_SMTP_PORT=465
# ACTOR_PLATFORM_SMTP_USER=
# ACTOR_PLATFORM_SMTP_PASSWORD=
# ACTOR_PLATFORM_SMTP_FROM=
