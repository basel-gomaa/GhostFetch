# The pipeline's settings (python3 main.py). Copy to .env and fill in:
#     cp .env.example .env && chmod 600 .env
# .env is gitignored. Never commit real values.

# Optional. Without it the demo build uses an offline keyword analysis
# (ai/demo_analysis.py); with it, the real Claude analysis runs on the demo data.
ANTHROPIC_API_KEY=

# Optional: e-mail the finished report. Skipped with a warning when unset.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=                          # a Gmail APP password, not the account password
REPORT_RECIPIENT=
